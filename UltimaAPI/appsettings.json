{
  "Urls": "http://127.0.0.1:5027",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Ultima": {
    "DataPath": null,
    "CacheData": true,
    "UseMapDiffs": true,
    "EnableWritableUopShadow": true,
    "UopCachePath": null,
    "Limits": {
      "MaxSearchResults": 100,
      "MaxMapRegionSize": 64,
      "MaxMapRenderBlocks": 32,
      "MaxAnimationFrames": 32,
      "MaxTextLength": 512
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
